{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DriveEncryptor",
  "version": "0.3.0",
  "identifier": "com.driveencryptor.app",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "windows": [
      {
        "title": "DriveEncryptor",
        "width": 900,
        "height": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "icon": ["icons/icon.png"],
    "category": "Utility",
    "shortDescription": "Encrypt drives with AES-256-XTS",
    "longDescription": "DriveEncryptor encrypts external and secondary internal drives with AES-256-XTS via VeraCrypt, with a printable 256-bit recovery key for backup access."
  }
}
